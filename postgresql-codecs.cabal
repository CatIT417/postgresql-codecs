cabal-version: 3.0
name: postgresql-codecs
version: 0
category: PostgreSQL, Codecs
synopsis: Driver-agnostic PostgreSQL codecs library
description:
  postgresql-codecs is a driver-agnostic library for encoding and decoding
  PostgreSQL values. It is organised in five composable layers: Scalar (type
  metadata and binary\/textual codec pair), Dimensionality (scalar or
  N-dimensional array), Nullability (nullable or non-nullable elements),
  Columns\/Params (result-row decoder and query-parameter encoder), and Result
  (full result-set strategy). Both the binary and textual PostgreSQL wire
  formats are supported. Driver integration requires only a small
  ConsumesColumns instance; the library ships no I\/O of its own.

homepage: https://github.com/nikita-volkov/postgresql-codecs
bug-reports: https://github.com/nikita-volkov/postgresql-codecs/issues
author: Nikita Volkov <nikita.y.volkov@mail.ru>
maintainer: Nikita Volkov <nikita.y.volkov@mail.ru>
copyright: (c) 2026, Nikita Volkov
license: MIT
license-file: LICENSE
extra-doc-files:
  LICENSE

source-repository head
  type: git
  location: https://github.com/nikita-volkov/postgresql-codecs

common base
  default-language: Haskell2010
  default-extensions:
    ApplicativeDo
    BangPatterns
    BinaryLiterals
    BlockArguments
    ConstraintKinds
    DataKinds
    DefaultSignatures
    DeriveDataTypeable
    DeriveFoldable
    DeriveFunctor
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    DuplicateRecordFields
    EmptyDataDecls
    FlexibleContexts
    FlexibleInstances
    FunctionalDependencies
    GADTs
    GeneralizedNewtypeDeriving
    LambdaCase
    LiberalTypeSynonyms
    MagicHash
    MultiParamTypeClasses
    MultiWayIf
    NamedFieldPuns
    NoFieldSelectors
    NoImplicitPrelude
    NoMonomorphismRestriction
    NumericUnderscores
    OverloadedRecordDot
    OverloadedStrings
    ParallelListComp
    PatternGuards
    QuasiQuotes
    RankNTypes
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    StrictData
    TemplateHaskell
    TupleSections
    TypeApplications
    TypeFamilies
    TypeOperators
    UnboxedTuples
    ViewPatterns

common executable
  import: base
  ghc-options:
    -O2
    -threaded
    -with-rtsopts=-N
    -rtsopts
    -funbox-strict-fields

common test
  import: base
  ghc-options:
    -threaded
    -with-rtsopts=-N

library
  import: base
  hs-source-dirs: src/postgresql-codecs
  exposed-modules:
    PostgresqlCodecs

  other-modules:
    PostgresqlCodecs.Columns
    PostgresqlCodecs.Dimension
    PostgresqlCodecs.Dimensionality
    PostgresqlCodecs.Dimensionality.Writes
    PostgresqlCodecs.Fields
    PostgresqlCodecs.Nullability
    PostgresqlCodecs.Params
    PostgresqlCodecs.Prelude
    PostgresqlCodecs.Report
    PostgresqlCodecs.Resolver
    PostgresqlCodecs.Result
    PostgresqlCodecs.Scalar

  build-depends:
    attoparsec >=0.14 && <0.15,
    base >=4.11 && <5,
    bytestring >=0.10 && <0.13,
    containers >=0.6 && <0.9,
    invariant ^>=0.6.4,
    lawful-conversions ^>=0.3,
    mtl >=2.2 && <3,
    postgresql-types ^>=0.1.5,
    postgresql-types-algebra ^>=0.2,
    profunctors ^>=5.6 && <6,
    ptr-peeker ^>=0.2,
    ptr-poker ^>=0.1.3,
    QuickCheck >=2.14 && <3,
    tagged ^>=0.8.9,
    text >=1.2 && <3,
    text-builder ^>=1.0.0.4,
    time >=1.12 && <2,
    transformers >=0.5 && <0.7,
    uuid >=1.3 && <2,
    vector ^>=0.13,
    vector-extras ^>=0.3,

library demo
  import: base
  hs-source-dirs: src/demo
  exposed-modules:
    Demo.Types

  other-modules:
    Demo.Types.Artist
    Demo.Types.Genre

  build-depends:
    postgresql-codecs,
    rerebase ^>=1.22,

test-suite integration-test
  import: test
  type: exitcode-stdio-1.0
  hs-source-dirs: src/integration-test
  main-is: Spec.hs
  other-modules:
    IntegrationTest.ColumnsSpec
    IntegrationTest.DimensionalitySpec
    IntegrationTest.DimensionSpec
    IntegrationTest.FieldsSpec
    IntegrationTest.Integrations.Pq
    IntegrationTest.Integrations.Pq.RowDecoder
    IntegrationTest.NullabilitySpec
    IntegrationTest.ParamsSpec
    IntegrationTest.ResultSpec
    IntegrationTest.ScalarSpec
    IntegrationTest.SpecHook

  build-tool-depends:
    hspec-discover:hspec-discover

  build-depends:
    base >=4.11 && <5,
    bytestring >=0.10 && <0.13,
    containers >=0.6 && <0.9,
    hspec >=2.11 && <2.12,
    postgresql-codecs,
    postgresql-codecs:demo,
    postgresql-libpq >=0.9 && <0.12,
    postgresql-types ^>=0.1.5,
    postgresql-types-algebra ^>=0.2,
    profunctors ^>=5.6 && <6,
    ptr-peeker ^>=0.2,
    ptr-poker ^>=0.1.3,
    resource-pool >=0.4 && <0.5,
    tagged ^>=0.8.9,
    testcontainers >=0.5 && <0.7,
    testcontainers-postgresql,
    text >=1.2 && <3,
    text-builder ^>=1.0.0.4,
    vector ^>=0.13,
